# Copier en .env (non versionné) et renseigner.
DB_USER=arlette
DB_PASSWORD=changer-moi
# openssl rand -base64 48
JWT_SECRET=
# Clé de signature des QR de pointage, différente de JWT_SECRET (openssl rand -base64 48)
POINTAGE_SECRET=
# Chiffrement au repos AES-GCM (téléphones, e-mails, salaires, motifs) — hors base (openssl rand -base64 32)
CRYPTO_KEY=
CORS_ORIGINS=https://arlettedebo.sn
# Dossier du serveur où sont écrits les justificatifs (à sauvegarder avec la base)
STORAGE_DIR=/srv/arlette-debo/justificatifs
# Swagger UI (staging uniquement — laisser false en prod publique)
EXPOSE_API_DOCS=false
PUBLIC_API_URL=http://149.56.45.75:8080
PUBLIC_APP_URL=https://arlettedebo.sn
# SMTP (Gmail / autre) — sans credentials, les e-mails sont ignorés (log warn)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Tous les destinataires réécrits vers ce domaine (inbox yopmail) — vide = adresse réelle
MAIL_REWRITE_DOMAIN=yopmail.com
# Socle comptes/RH (true) ; démo métier RDV/caisse/qualité (false en ouverture)
SEED_ENABLED=true
SEED_DEMO=false
SEED_PASSWORD=
SEED_FORCE_PASSWORD_CHANGE=true
