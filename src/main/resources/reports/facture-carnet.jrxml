        </textElement>
        <textFieldExpression><![CDATA["Nº " + $P{NUMERO}]]></textFieldExpression>
      </textField>

      <!-- Facture à -->
      <staticText>
        <reportElement x="0" y="72" width="70" height="16" uuid="66666666-6666-6666-6666-666666666666"/>
