        </textElement>
        <textFieldExpression><![CDATA[$P{MARQUE}]]></textFieldExpression>
      </textField>
      <!-- Pastille Facture -->
      <rectangle radius="10">
        <reportElement x="278" y="4" width="102" height="28" backcolor="#1A1A1A" uuid="33333333-3333-3333-3333-333333333333">
          <property name="com.jaspersoft.studio.unit.width" value="px"/>
